# Razorpay Dashboard → Account & Settings → API Keys
# Test keys rzp_test_ se start hoti hain. Live keys rzp_live_ se.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional. Sirf tab chahiye jab Razorpay Dashboard me webhook lagana ho.
# Webhook URL: https://your-domain.com/api/razorpay-webhook
# Event: payment.captured
RAZORPAY_WEBHOOK_SECRET=

PRODUCT_NAME=3000+ Presets Pack
PRODUCT_PRICE_INR=299

# Payment success ke baad yahi link email par jayegi.
# Drive file sharing: Anyone with the link → Viewer
GOOGLE_DRIVE_LINK=

# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=google-app-password
# EMAIL_FROM=Presets Pack <your@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/presets-pack?retryWrites=true&w=majority
ADMIN_EMAIL=admin@presets.local
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=long-random-string
